# Copy this file to .env and fill in your local values.

GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REPO_BRIEF_LIMIT=8

DATE_WINDOW_DAYS=7
MAX_ITEMS_PER_SOURCE=20
GITHUB_MAX_REPO_AGE_DAYS=60

# Query tiers
GITHUB_ENABLE_EMERGING_QUERIES=1
GITHUB_SEARCH_PER_QUERY=8

# Dynamic emerging refresh (auto-apply each run)
GITHUB_DYNAMIC_AUTO_UPDATE=1
GITHUB_DYNAMIC_MAX_QUERY_REPLACEMENTS=4
GITHUB_DYNAMIC_MAX_WATCH_REPLACEMENTS=4
GITHUB_DYNAMIC_MAX_EMERGING_QUERIES=7
GITHUB_DYNAMIC_MAX_EMERGING_WATCH=8

# Traction thresholds (lower value for emerging-topic repos)
TRACTION_THRESHOLD_DEFAULT=35
TRACTION_THRESHOLD_EMERGING=25

# Watchlist extensions (comma-separated owner/repo pairs)
GITHUB_REPOS_EVERGREEN_EXTRA=
GITHUB_REPOS_TO_WATCH_EXTRA=

ARXIV_MAX_RESULTS_PER_CATEGORY=25
