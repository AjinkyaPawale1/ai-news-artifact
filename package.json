{
  "name": "ai-news-artifact",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "author": "Ajinkya Pawale",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.js",
    "pipeline": "PYTHONPATH=apps/pipeline/src python3 -m news_pipeline.supervisor",
    "pipeline:papers": "PYTHONPATH=apps/pipeline/src python3 -m news_pipeline.paper_pipeline",
