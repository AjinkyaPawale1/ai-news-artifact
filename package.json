    "preview": "vite preview --config apps/web/vite.config.js"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "rollup": "npm:@rollup/wasm-node@^4.60.4",
    "vite": "^5.4.10"
  }
}
